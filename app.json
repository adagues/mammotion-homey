          "options": {
            "title": {
              "en": "Log in to Mammotion"
            },
            "usernameLabel": {
              "en": "Email"
            },
            "usernamePlaceholder": {
              "en": "your@email.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        },
        {
